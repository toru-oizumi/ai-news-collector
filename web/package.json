{
  "name": "ai-news-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "use-fixture": "node -e \"const f=require('node:fs');if(f.existsSync('src/data/articles.json')){console.log('articles.json exists — keeping it')}else{f.copyFileSync('src/data/articles.fixture.json','src/data/articles.json');console.log('copied fixture -> articles.json')}\"",
    "deploy": "wrangler deploy",
    "check:worker": "tsc -p worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "astro": "^7.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260810.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
