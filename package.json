{
  "name": "ai-news-collector",
  "version": "1.0.0",
  "description": "Collect AI/ML news from various sources and push to Notion",
  "type": "module",
  "scripts": {
    "collect": "tsx --no-deprecation src/main.ts",
    "collect:dry": "tsx --no-deprecation src/main.ts --dry-run",
    "digest": "tsx --no-deprecation src/digest-main.ts",
    "digest:dry": "tsx --no-deprecation src/digest-main.ts --dry-run",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\" \"#.serena\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\" \"#.serena\""
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "cheerio": "^1.0.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "markdownlint-cli2": "^0.17.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
